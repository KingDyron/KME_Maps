const	
	PLAYER = 0;
{.$DEFINE DebugDialog}
{.$DEFINE DebugHero}
{$DEFINE DebugGameSpeed}
{$I KD_CustomPanel.script} //custom panel 
{$I KD_Dialog.script}
{$I KD_Heroes.script}
{.$I KD_SaveDefPos.script}
{.$I KD_GatherResources.script}
{$I KD_Events.script}
	
var Iris, IrisG, Teth, Barbarian : Integer;
	DialogEnd : Integer;
	
procedure ShowMsg(I : Integer);
begin
	A.ShowMsg(PLAYER, IntToMsg(I));
end;

procedure OnTick;
var GT : Cardinal;
begin
	GT := S.GameTime;
	If GT = DialogEnd then 
		A.PlayerWin([0], true);
	
	If GT = 2 then 
		A.CinematicPanTo(PLAYER, 77, 43, 300);
	If GT = Dialog_IndexAtTime(36) then 
	begin
		A.CinematicPanTo(PLAYER, 21, 62, 600);
		A.GroupOrderWalk(IrisG, 22, 62, 6);
	end;
end;

procedure OnMissionStart;
begin
	Iris := S.UnitAt(54, 53);
	IrisG := S.GroupAt(54, 53);
	Teth := S.UnitAt(19, 62);
	Barbarian := S.UnitAt(27, 61);
	
	Hero_AddFromLoc(53, 51, 12, 'Dyron', false);
	Hero_SetStats('Dyron', 10, 130, 10, 5, 26, 0, 2, 3);	
	
	OverlayDialogSetup;	
	Dialog_SetStartTime(1);
	Dialog_Loc(55, 51);
	Dialog_Add(50, 52, Hero_IDByName('Dyron') );
	Dialog_Add(51, 52, Iris );
	Dialog_Add(52, 33, Hero_IDByName('Dyron') );
