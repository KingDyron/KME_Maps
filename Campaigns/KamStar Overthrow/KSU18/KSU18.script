	Dialog_Add(57, 134, Iris );
	Dialog_Add(58, 80, Hero_IDByName('Dyron') );
	Dialog_Add(59, 76, Iris );
	Dialog_Add(60, 30, Hero_IDByName('Dyron') );
	Dialog_Add(61, 85, Iris );
	Dialog_Add(62, 30, Hero_IDByName('Dyron') );
	Dialog_Add(63, 48, Iris );
	Dialog_Add(64, 100, Hero_IDByName('Dyron') );
	Dialog_Add(65, 32, Iris );
	Dialog_Add(66, 246, Hero_IDByName('Dyron') );
