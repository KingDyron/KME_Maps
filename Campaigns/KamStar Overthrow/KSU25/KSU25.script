const	
	PLAYER = 0;
{.$DEFINE DebugDialog}
{.$DEFINE DebugHero}
{$DEFINE DebugGameSpeed}
{$I KD_CustomPanel.script} //custom panel 
{$I KD_Dialog.script}
{$I KD_Heroes.script}
{.$I KD_SaveDefPos.script}
{.$I KD_GatherResources.script}
{.$I KD_GatherArmy.script}
{.$I KD_Events.script}	

type
	TKDTrap = record
		Pos, Pos2 : TKMPoint; //killing pos
		ActivationRadius: Single;
		Animation : array of Integer;
		ActivationTime : Integer;
		Delay : Integer;	
		AutoActivate : Boolean;		
		AlwaysActive: Boolean;
		CheckAgainTime : Integer;
	end;
	
var Traps : array of TKDTrap;
	GT : Integer;
	Dyron, Giant : Integer;
	DarknessTime : Integer;
	GiantSpawned : Boolean;
	EntranceBlocked : Boolean;
	Dialog1Added : Boolean;
	



var addX, addY : Integer;
function CombineAutoTrap(X, Y : Integer; aAnimation : array of Integer; Delay : Integer) : TKDTrap;
begin
	Result.Pos.X := X;
	Result.Pos.Y := Y;
	Result.Animation := aAnimation;
	Result.Delay := Delay;
	Result.AutoActivate := true;
end;

function CombinePosTrap(X, Y : Integer; aAnimation : array of Integer; Radius : Single; Delay : Integer) : TKDTrap;
begin
	Result.Pos.X := X;
	Result.Pos.Y := Y;
	Result.Pos2.X := X + addX;
	Result.Pos2.Y := Y + addY;
	Result.Animation := aAnimation;
	Result.ActivationRadius := Radius;
	Result.Delay := Delay;
end;

function AddTrap(aTrap : TKDTrap) : Integer;
begin
	Result := length(Traps);
	SetLength(Traps, Result + 1);
	Traps[Result] := aTrap;
	Traps[Result].ActivationTime := S.KaMRandomI(100);
end;

procedure PlayTrapAnim(var aTrap : TKDTrap; aLoops : Integer);
begin
	A.SpecialAnimAddFront(aTrap.Pos.X, aTrap.Pos.Y, aTrap.Animation, aLoops);//explosion	
end;

procedure ActivateAlwaysActiveTraps;
var I : integer;
begin
	for I := 0 to high(Traps) do
		If Traps[I].AlwaysActive then 
			PlayTrapAnim(Traps[I], 999999);
end;

function PosInRadiusF(aPos1, aPos2 : TKMPoint; aRadius : Single) : Boolean;
begin
	Result := U.Power( U.Sqr(aPos1.X - aPos2.X) + U.Sqr(aPos1.Y - aPos2.Y), 0.5 ) <= aRadius;
end;

procedure CheckTrap(var aTrap : TKDTrap; Pos : TKMPoint);
begin
	If aTrap.AutoActivate then //explosions
	begin
		If GT >= aTrap.ActivationTime + aTrap.Delay then 
		begin
			aTrap.ActivationTime := GT;
			If PosInRadiusF(aTrap.Pos, Pos, 2.5) then 
				A.UnitKill(Dyron, false);	
			PlayTrapAnim(aTrap, 1);		
		end;
	end else
	If aTrap.AlwaysActive then //clouds
	begin
		If PosInRadiusF(aTrap.Pos, Pos, aTrap.ActivationRadius) then 
		begin
			DarknessTime := GT + 300;
		end;
	end else
	//hero is in radius so activate
	If PosInRadiusF(aTrap.Pos, Pos, 1.42) and (GT >= aTrap.ActivationTime + aTrap.Delay) then
	begin		
		aTrap.ActivationTime := GT;
		aTrap.CheckAgainTime := GT + 15;
		PlayTrapAnim(aTrap, 1);		
		If (aTrap.Pos = Pos) or (aTrap.Pos2 = Pos) then 
			A.UnitKill(Dyron, false);	
	end else
	If GT <= aTrap.CheckAgainTime then
	begin
		If (aTrap.Pos = Pos) or (aTrap.Pos2 = Pos) then 
			A.UnitKill(Dyron, false);	
	end;

end;

procedure CheckTraps(Pos : TKMPoint);
var I : Integer;
begin
	for I := 0 to high(Traps) do 
		CheckTrap(Traps[I], Pos);
end;


procedure ShowMsg(I : Integer);
begin
	A.ShowMsg(PLAYER, IntToMsg(I));
end;

procedure OnTick;
var Pos : TKMPoint;
begin
	GT := S.GameTime;
	If GT = 1 then 
		gDialog.DoCinematic := false;
	
	If GT mod 5 = 0 then 
	begin
		Pos := Hero_Pos('Dyron');
		A.FogCoverAll(PLAYER);
		If Pos.X > 0 then
			If GT < DarknessTime then 
				A.FogRevealCircle(PLAYER, Pos.X, Pos.Y, 3)
			else
				A.FogRevealCircle(PLAYER, Pos.X, Pos.Y, 6);
		//A.FogRevealAll(0);		
		CheckTraps(Pos);
	end;
	If not GiantSpawned then 
	begin
		If GT mod 2243 = 0 then 
			A.PlayOGG(0, 'FootSteps', 1);
			
		If GT mod 20 = 0 then 
			If Hero_IsCloseTo('Dyron', 62, 59, 10) then
			begin
				GiantSpawned := true;
				Giant := A.GiveGroup(1, 39, 66, 27, 4, 1, 1);
				Dialog_SetStartTime(1);
				Dialog_Add(50, 10, -1 );
				Dialog_Add(51, 10, -1 );
				Dialog_Add(52, 10, -1 );
				Dialog_Add(53, 10, -1 );
				Dialog_Add(54, 50, -1 );
			end;
	end;
	If GT mod 10 = 0 then
	begin
		If not Dialog1Added then
			If Hero_IsCloseTo('Dyron', 119, 87, 4) or Hero_IsCloseTo('Dyron', 83, 124, 4) then 
			begin
				Dialog_SetStartTime(1);
				Dialog_Add(55, 10, -1 );
				Dialog_Add(56, 10, -1 );
				Dialog_Add(57, 10, -1 );
				Dialog_Add(58, 10, -1 );
				Dialog_Add(59, 10, -1 );
				Dialog_Add(60, 50, -1 );		
				Dialog1Added := true;				
			end;
		
		If not EntranceBlocked then 
			If Hero_IsCloseTo('Dyron', 119, 102, 1) then
			begin
				EntranceBlocked := true;
				A.MapTileObjectSet(122, 102, 9);
				A.MapTileObjectSet(121, 102, 8);
				Dialog_SetStartTime(1);
				Dialog_Add(61, 35, Dyron );
				Dialog_Add(55, 10, -1 );
				Dialog_Add(56, 10, -1 );
				Dialog_Add(57, 10, -1 );
				Dialog_Add(58, 10, -1 );
				Dialog_Add(59, 10, -1 );
				Dialog_Add(60, 10, -1 );
				Dialog_Add(62, 25, Dyron );
			end;
	end;
end;

