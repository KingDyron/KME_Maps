	AddTrap(CombinePosTrap(2, 14, [1599, 1602, 1605, 1605, 1605, 1605, 1605, 1604, 1603, 1602, 1601, 1600, 1599], 1, 600));
	AddTrap(CombinePosTrap(39, 4, [1599, 1602, 1605, 1605, 1605, 1605, 1605, 1604, 1603, 1602, 1601, 1600, 1599], 1, 600));
	AddTrap(CombinePosTrap(121, 11, [1599, 1602, 1605, 1605, 1605, 1605, 1605, 1604, 1603, 1602, 1601, 1600, 1599], 1, 600));
	AddTrap(CombinePosTrap(83, 32, [1599, 1602, 1605, 1605, 1605, 1605, 1605, 1604, 1603, 1602, 1601, 1600, 1599], 1, 600));
	AddTrap(CombinePosTrap(65, 93, [1599, 1602, 1605, 1605, 1605, 1605, 1605, 1604, 1603, 1602, 1601, 1600, 1599], 1, 600));
	AddTrap(CombinePosTrap(115, 93, [1599, 1602, 1605, 1605, 1605, 1605, 1605, 1604, 1603, 1602, 1601, 1600, 1599], 1, 600));
	//bottom>top spikes
	addX := 0;
	addY := -1;
	AddTrap(CombinePosTrap(24, 27, [1592, 1595, 1598, 1598, 1598, 1598, 1598, 1597, 1596, 1595, 1594, 1593, 1592], 1, 600));
	AddTrap(CombinePosTrap(50, 21, [1592, 1595, 1598, 1598, 1598, 1598, 1598, 1597, 1596, 1595, 1594, 1593, 1592], 1, 600));
	AddTrap(CombinePosTrap(87, 39, [1592, 1595, 1598, 1598, 1598, 1598, 1598, 1597, 1596, 1595, 1594, 1593, 1592], 1, 600));
	AddTrap(CombinePosTrap(73, 20, [1592, 1595, 1598, 1598, 1598, 1598, 1598, 1597, 1596, 1595, 1594, 1593, 1592], 1, 600));
	addX := 0;
	addY := 0;
	//duration traps
	//auto traps
	AddTrap(CombineAutoTrap(31, 16, [1606, 1607, 1608, 1609, 1610], 80));
	AddTrap(CombineAutoTrap(66, 39, [1606, 1607, 1608, 1609, 1610], 100));
	AddTrap(CombineAutoTrap(102, 37, [1606, 1607, 1608, 1609, 1610], 150));
	AddTrap(CombineAutoTrap(19, 62, [1606, 1607, 1608, 1609, 1610], 140));
	AddTrap(CombineAutoTrap(60, 94, [1606, 1607, 1608, 1609, 1610], 160));
	AddTrap(CombineAutoTrap(13, 78, [1606, 1607, 1608, 1609, 1610], 120));
	//always active traps
	J := AddTrap(CombinePosTrap(95, 28, [993, 994, 995, 996, 997, 998, 999, 1000, 1001, 1002, 1003, 1004, 1005, 1006], 3, 1));
	AddTrap(CombinePosTrap(65, 30, [993, 994, 995, 996, 997, 998, 999, 1000, 1001, 1002, 1003, 1004, 1005, 1006], 3, 1));
	AddTrap(CombinePosTrap(59, 112, [993, 994, 995, 996, 997, 998, 999, 1000, 1001, 1002, 1003, 1004, 1005, 1006], 3, 1));
	AddTrap(CombinePosTrap(121, 76, [993, 994, 995, 996, 997, 998, 999, 1000, 1001, 1002, 1003, 1004, 1005, 1006], 3, 1));
	AddTrap(CombinePosTrap(24, 44, [993, 994, 995, 996, 997, 998, 999, 1000, 1001, 1002, 1003, 1004, 1005, 1006], 3, 1));
	AddTrap(CombinePosTrap(23, 12, [993, 994, 995, 996, 997, 998, 999, 1000, 1001, 1002, 1003, 1004, 1005, 1006], 3, 1));
