var I, J : Integer;
begin	
	Hero_AddFromLoc(67, 2, 12, 'Dyron', false);
	Hero_SetStats('Dyron', 10, 130, 10, 5, 22, 3, 2, 3);	
	Dyron := Hero_IDByName('Dyron');
