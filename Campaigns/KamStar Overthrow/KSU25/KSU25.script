	AddTrap(CombinePosTrap(40, 86, [1585, 1588, 1591, 1591, 1591, 1591, 1591, 1590, 1589, 1588, 1587, 1586, 1585], 1, 600));
	AddTrap(CombinePosTrap(91, 78, [1585, 1588, 1591, 1591, 1591, 1591, 1591, 1590, 1589, 1588, 1587, 1586, 1585], 1, 600));
	AddTrap(CombinePosTrap(20, 35, [1585, 1588, 1591, 1591, 1591, 1591, 1591, 1590, 1589, 1588, 1587, 1586, 1585], 1, 600));
	//left>right spikes
