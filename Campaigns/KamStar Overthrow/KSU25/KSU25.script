{traps animation
	A.SpecialAnimAddFront(X, Y, [1578, 1581, 1584, 1584, 1584, 1584, 1584, 1583, 1582, 1581, 1580, 1579, 1578], 1);//top-down
	A.SpecialAnimAddFront(X, Y, [1585, 1588, 1591, 1591, 1591, 1591, 1591, 1590, 1589, 1588, 1587, 1586, 1585], 1);//right- left
	A.SpecialAnimAddFront(X, Y, [1592, 1595, 1598, 1598, 1598, 1598, 1598, 1597, 1596, 1595, 1594, 1593, 1592], 1);//down-top
